# ==============================================================================
# BLUE CHECK-IN — Server-Only Environment Variables Template
# Copy to `.env.local` for local development and add to Vercel Project Settings.
# NEVER commit `.env.local` or expose any secret key with `NEXT_PUBLIC_`.
# ==============================================================================

# Supabase Project URL (Settings -> Data API / API Keys)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Server-Only Secret Key (Settings -> API Keys -> Secret keys: sb_secret_...)
# NEVER prefix with NEXT_PUBLIC_
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_key

# HMAC-SHA256 Session & Backup signing secret (generate 32+ random bytes in hex)
SESSION_SECRET=replace_with_64_hex_characters

# Initial 6-digit PINs used ONLY once if `app_security_config` table is empty.
# Immediately hashed with salted scrypt in PostgreSQL; change anytime from /admin.
INITIAL_STAFF_PIN=256900
INITIAL_ADMIN_PIN=996900

# Salted scrypt hash of Owner Recovery Key (`scrypt$<salt_hex>$<hash_hex>`)
# Required exclusively for Full-System Restore and Emergency PIN Reset.
# Generate with: node scripts/hash-secret.mjs "YOUR_STRONG_OWNER_KEY"
OWNER_RECOVERY_KEY_HASH=scrypt$replace_salt$replace_hash
